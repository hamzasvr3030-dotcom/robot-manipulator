<?xml version="1.0"?>
<!--
  3-DOF düzlemsel RRR kol — kod/robot_kol.py ile aynı ölçüler.
  Kol x–z düşey düzleminde hareket eder; eklemler y ekseni etrafında döner.
  Eksen (0 -1 0) seçildi: pozitif açı kolu yukarı kaldırır (kod/robot_kol.py ile aynı yön).
  Kütleler kod/k04_tork.py girdileriyle uyumludur.
-->
<robot name="rrr_kol">

  <material name="gri"><color rgba="0.4 0.4 0.4 1"/></material>
  <material name="mavi"><color rgba="0.30 0.45 0.69 1"/></material>
  <material name="turuncu"><color rgba="0.87 0.52 0.32 1"/></material>
  <material name="kirmizi"><color rgba="0.77 0.31 0.32 1"/></material>

  <link name="world"/>

  <!-- Taban -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.025"/>
      <geometry><cylinder radius="0.08" length="0.05"/></geometry>
      <material name="gri"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.025"/>
      <geometry><cylinder radius="0.08" length="0.05"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.025"/>
      <mass value="3.0"/>
      <inertia ixx="0.0054" iyy="0.0054" izz="0.0096" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/><child link="base_link"/>
  </joint>

  <!-- Uzuv 1: L1 = 0.30 m, 1.20 kg -->
  <link name="link1">
    <visual>
      <origin xyz="0.15 0 0"/>
      <geometry><box size="0.30 0.05 0.05"/></geometry>
      <material name="mavi"/>
    </visual>
    <collision>
      <origin xyz="0.15 0 0"/>
      <geometry><box size="0.30 0.05 0.05"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.15 0 0"/>
      <mass value="1.20"/>
      <inertia ixx="0.0005" iyy="0.0093" izz="0.0093" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="joint1" type="revolute">
    <parent link="base_link"/><child link="link1"/>
    <origin xyz="0 0 0.08"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="25" velocity="1.57"/>
  </joint>

  <!-- Uzuv 2: L2 = 0.25 m, 0.90 kg -->
  <link name="link2">
    <visual>
      <origin xyz="0.125 0 0"/>
      <geometry><box size="0.25 0.04 0.04"/></geometry>
      <material name="turuncu"/>
    </visual>
    <collision>
      <origin xyz="0.125 0 0"/>
      <geometry><box size="0.25 0.04 0.04"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.125 0 0"/>
      <mass value="0.90"/>
      <inertia ixx="0.00024" iyy="0.0048" izz="0.0048" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="joint2" type="revolute">
    <parent link="link1"/><child link="link2"/>
    <origin xyz="0.30 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-2.618" upper="2.618" effort="8" velocity="2.09"/>
  </joint>

  <!-- Uzuv 3: L3 = 0.10 m, 0.30 kg -->
  <link name="link3">
    <visual>
      <origin xyz="0.05 0 0"/>
      <geometry><box size="0.10 0.03 0.03"/></geometry>
      <material name="kirmizi"/>
    </visual>
    <collision>
      <origin xyz="0.05 0 0"/>
      <geometry><box size="0.10 0.03 0.03"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.05 0 0"/>
      <mass value="0.30"/>
      <inertia ixx="0.000045" iyy="0.00027" izz="0.00027" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="joint3" type="revolute">
    <parent link="link2"/><child link="link3"/>
    <origin xyz="0.25 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-2.618" upper="2.618" effort="2" velocity="3.14"/>
  </joint>

  <!-- Uç efektör çerçevesi (MoveIt'te planlama ucu olarak kullanılır) -->
  <link name="tool0"/>
  <joint name="tool0_joint" type="fixed">
    <parent link="link3"/><child link="tool0"/>
    <origin xyz="0.10 0 0"/>
  </joint>

</robot>
